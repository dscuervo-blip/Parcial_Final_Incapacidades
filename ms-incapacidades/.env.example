APP_NAME=ms-incapacidades
APP_ENV=local
APP_DEBUG=true
APP_PORT=8003
APP_TIMEZONE=America/Bogota

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ms-incapacidades
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Conexión de solo lectura a la BD de ms-auth (validación del token)
AUTH_DB_HOST=127.0.0.1
AUTH_DB_PORT=3306
AUTH_DB_DATABASE=ms-auth
AUTH_DB_USERNAME=root
AUTH_DB_PASSWORD=

# Conexión de solo lectura a la BD de ms-empleados (validar que el empleado exista y mostrar su nombre)
EMPLEADOS_DB_HOST=127.0.0.1
EMPLEADOS_DB_PORT=3306
EMPLEADOS_DB_DATABASE=ms-empleados
EMPLEADOS_DB_USERNAME=root
EMPLEADOS_DB_PASSWORD=

CORS_ALLOWED_ORIGIN=*
